# Server port (5001 avoids the macOS AirPlay Receiver conflict on 5000)
PORT=5001

# MongoDB connection string (Atlas or local). Example Atlas format:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/trackit
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/trackit

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Allowed CORS origin for the Vite dev server
CLIENT_ORIGIN=http://localhost:5173
